generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String

  createdById String?
  createdBy   User? @relation("OrganizationCreatedBy",fields: [createdById], references: [id] )

  branches    Branch[]
  users       User[]
  jobs        Job[]
  candidates  Candidate[]

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

model Branch {
  id             String @id @default(uuid())

  name           String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  password     String
  role         Role

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])

  createdOrganizations Organization[] @relation("OrganizationCreatedBy")

  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  isActive     Boolean @default(true)

  candidates   Candidate[]
  createdJobs  Job[] @relation("JobCreatedBy")
  updatedJobs  Job[] @relation("JobUpdatedBy")
  sessions     Session[]
  profile      UserProfile?
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  phone        String?
  bio          String?
  addressLine1 String?
  city         String?
  state        String?
  country      String?
  zipCode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  device       String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean   @default(true)
  expiresAt    DateTime  @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  tokenHash    String?   @unique
  lastActiveAt DateTime? @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

model Job {
  id             String                 @id @default(uuid())
  title          String
  slug           String                 @unique
  description    String
  requiredSkills String[]
  niceToHave     String[]
  experienceMin  Int?
  experienceMax  Int?
  embedding      Unsupported("vector")?
  orgId          String
  createdBy      String
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  updatedBy      String?
  jdHtml         String?
  disabled       Boolean                @default(false)
  applications   Application[]
  creator        User                   @relation("JobCreatedBy", fields: [createdBy], references: [id])
  organization   Organization           @relation(fields: [orgId], references: [id])
  updater        User?                  @relation("JobUpdatedBy", fields: [updatedBy], references: [id])
}

model Candidate {
  id               String        @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  name             String
  email            String
  phone            String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  orgId            String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  currentRole      String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  linkedinUrl      String?
  skills           String[]
  totalExperience  Float?
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  currentCTC       Float?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  expectedSalary   Float?
  isOnNoticePeriod Boolean       @default(false)
  noticePeriod     Int?
  createdBy        String?
  isBlocked        Boolean       @default(false)
  applications     Application[]
  creator          User?         @relation(fields: [createdBy], references: [id])
  organization     Organization  @relation(fields: [orgId], references: [id])
  resumes          Resume[]

  @@index([email])
  @@index([phone])
  @@index([orgId])
}

model Resume {
  id           String        @id @default(uuid())
  candidateId  String
  fileName     String?
  fileSize     Int?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  mimeType     String?
  resumeUrl    String
  applications Application[]
  candidate    Candidate     @relation(fields: [candidateId], references: [id])
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  candidateId   String
  resumeId      String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  status        ApplicationStatus @default(APPLIED)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  overallScore  Int?
  aiSummary     String?
  matchedSkills String[]
  missingSkills String[]
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)
  candidate     Candidate         @relation(fields: [candidateId], references: [id])
  job           Job               @relation(fields: [jobId], references: [id])
  resume        Resume?           @relation(fields: [resumeId], references: [id])
  scores        CandidateScore?
  interview     Interview?
  logs          ProcessingLog[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model ProcessingLog {
  id            String      @id @default(uuid())
  applicationId String
  step          String
  status        String
  message       String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  application   Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model Interview {
  id            String              @id @default(uuid())
  applicationId String              @unique
  status        String
  cheatScore    Int?
  overallScore  Int?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  application   Application         @relation(fields: [applicationId], references: [id])
  questions     InterviewQuestion[]
}

model InterviewQuestion {
  id           String    @id @default(uuid())
  interviewId  String
  questionText String
  type         String
  options      Json?
  correct      Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  interview    Interview @relation(fields: [interviewId], references: [id])
}

model CandidateScore {
  id             String      @id @default(uuid())
  applicationId  String      @unique
  resumeScore    Int?
  interviewScore Int?
  cheatScore     Int?
  overallScore   Int?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  application    Application @relation(fields: [applicationId], references: [id])
}

enum Role {
  super_admin
  hr_manager
  recruiter
}

enum Source {
  applied
  manual
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  INTERVIEW
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
