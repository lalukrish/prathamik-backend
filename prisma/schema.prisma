generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  super_admin
  hr_manager
  recruiter
}

enum Source {
  applied
  manual
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  INTERVIEW
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id   String @id @default(uuid())
  name String

  users      User[]
  jobs       Job[]
  candidates Candidate[] // important

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String
  role     Role

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  isActive Boolean @default(true)
  sessions Session[]

  createdJobs Job[] @relation("JobCreatedBy")
  updatedJobs Job[] @relation("JobUpdatedBy")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

//////////////////////////////////////////////////////
// SESSIONS
//////////////////////////////////////////////////////

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tokenHash String? @unique   // referesh token jwt convert to hash

  device    String?
  ipAddress String?
  userAgent String?

  isActive  Boolean   @default(true)
  expiresAt DateTime @db.Timestamptz(6)  // ❗ make required

  lastActiveAt DateTime? @updatedAt @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([tokenHash])
}

//////////////////////////////////////////////////////
// JOBS
//////////////////////////////////////////////////////

model Job {
  id          String @id @default(uuid())
  title       String
  description String

  jdHtml      String?

  requiredSkills String[]
  niceToHave     String[]
  experienceMin  Int?
  experienceMax  Int?

  embedding Unsupported("vector")?

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  createdBy String
  creator   User @relation("JobCreatedBy", fields: [createdBy], references: [id])

  updatedBy String?
  updater   User? @relation("JobUpdatedBy", fields: [updatedBy], references: [id])

  applications Application[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

//////////////////////////////////////////////////////
// CANDIDATES
//////////////////////////////////////////////////////

model Candidate {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // BASIC INFO
  //////////////////////////////////////////////////////

  name  String
  email String
  phone String?

  //////////////////////////////////////////////////////
  // PROFESSIONAL INFO
  //////////////////////////////////////////////////////

  currentRole String?

  totalExperience Float?

  skills String[]

  //////////////////////////////////////////////////////
  // HIRING INFO
  //////////////////////////////////////////////////////

  expectedSalary Float?

  currentCTC Float?

  noticePeriod Int?

  isOnNoticePeriod Boolean @default(false)

  //////////////////////////////////////////////////////
  // LINKS
  //////////////////////////////////////////////////////

  linkedinUrl String?

  //////////////////////////////////////////////////////
  // ORGANIZATION
  //////////////////////////////////////////////////////

  orgId String

  organization Organization @relation(fields: [orgId], references: [id])

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  resumes Resume[]

  applications Application[]

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([email])

  @@index([phone])

  @@index([orgId])
}

//////////////////////////////////////////////////////
// RESUMES
//////////////////////////////////////////////////////

model Resume {
  id String @id @default(uuid())

  candidateId String

  candidate Candidate @relation(fields: [candidateId], references: [id])

  resumeUrl String

  fileName String?

  fileSize Int?

  mimeType String?

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  applications Application[]

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

//////////////////////////////////////////////////////
// APPLICATIONS
//////////////////////////////////////////////////////

model Application {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  candidateId String

  candidate Candidate @relation(fields: [candidateId], references: [id])

  jobId String

  job Job @relation(fields: [jobId], references: [id])

  resumeId String?

  resume Resume? @relation(fields: [resumeId], references: [id])

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  status ApplicationStatus @default(APPLIED)

  //////////////////////////////////////////////////////
  // AI RESULTS
  //////////////////////////////////////////////////////

  overallScore Int?

  aiSummary String?

  matchedSkills String[]

  missingSkills String[]

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  logs ProcessingLog[]

  interview Interview?

  scores CandidateScore?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@unique([candidateId, jobId])

  @@index([candidateId])

  @@index([jobId])

  @@index([status])
}

//////////////////////////////////////////////////////
// PROCESSING LOGS
//////////////////////////////////////////////////////

model ProcessingLog {
  id String @id @default(uuid())

  applicationId String

  application Application @relation(fields: [applicationId], references: [id])

  step String

  status String

  message String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([applicationId])
}

//////////////////////////////////////////////////////
// INTERVIEWS (PHASE 2)
//////////////////////////////////////////////////////

model Interview {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  status String

  cheatScore   Int?
  overallScore Int?

  startedAt   DateTime?
  completedAt DateTime?

  questions InterviewQuestion[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

//////////////////////////////////////////////////////
// INTERVIEW QUESTIONS
//////////////////////////////////////////////////////

model InterviewQuestion {
  id String @id @default(uuid())

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id])

  questionText String
  type         String
  options      Json?
  correct      Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

//////////////////////////////////////////////////////
// CANDIDATE SCORES
//////////////////////////////////////////////////////

model CandidateScore {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  resumeScore    Int?
  interviewScore Int?
  cheatScore     Int?
  overallScore   Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
