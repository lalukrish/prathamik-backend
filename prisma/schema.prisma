generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  ADMIN
  USER
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

enum TestStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  EXPIRED
}

enum SessionEvent {
  START
  PAUSE
  RESUME
  SUBMIT
  AUTO_SUBMIT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum UserStatus {
  ACTIVE
  BLOCKED
}


enum ExamCategory {
  UPSC
  SSC
  IBPS
  RRB
  NEET
  JEE
  PSC
  OTHER
}

enum AccessMode {
  FREE
  PAID
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}


enum StudyGroupCategory {
  UPSC
  SSC
  IBPS
  RRB
  NEET
  JEE
  PSC
  OTHER
}

enum TopicImportance {
  IMPORTANT
  MEDIUM_IMPORTANT
  LESS_IMPORTANT
}


enum PassStatus {
  ACTIVE
  EXPIRED
  REFUNDED
}


model AuthSession {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  refreshTokenHash String @unique

  expiresAt DateTime

  isActive Boolean @default(true)

  lastActiveAt DateTime?

  deviceInfo String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model User {
  id String @id @default(uuid())

  name String
  email String @unique
  password String

  role Role @default(USER)
  status UserStatus @default(ACTIVE)   // ← ADD THIS LINE

  authSessions AuthSession[]

  testsCreated MockTest[] @relation("CreatedTests")

  attempts TestAttempt[]      

  testSessions TestSession[]
  enrollments  UserTestEnrollment[]
  transactions Transaction[]
  studyTopics  StudyTopic[]
  topicVotes   TopicVote[]
  userPasses   UserPass[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model MockTest {
  id String @id @default(uuid())

  title String

  description String?

  durationMinutes Int

  totalMarks Int

  thumbnailUrl String?

  isPublished Boolean @default(false)

  createdById String
  createdBy User @relation("CreatedTests", fields: [createdById], references: [id])
  category        ExamCategory @default(OTHER)   
  accessMode      AccessMode   @default(FREE)    
  price           Float?                         
  questions Question[]
  attempts TestAttempt[]   

  sessions TestSession[]
  enrollments     UserTestEnrollment[]           
  transactions    Transaction[]                  
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Subject {
  id String @id @default(uuid())

  name String @unique

  questions Question[]

  createdAt DateTime @default(now())
}

model Question {
  id          String @id @default(uuid())

  mockTestId  String
  mockTest    MockTest @relation(fields: [mockTestId], references: [id])
  
  question    String
  imageUrl String?
  type        QuestionType @default(MCQ)

  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  marks Int @default(1)
  negativeMarks Float @default(0)
  options     Option[]
  description String?
  userAnswers UserAnswer[]  // <-- ADD THIS
  sortOrder Int @default(0)
  difficulty Difficulty @default(MEDIUM)

  createdAt   DateTime @default(now())
}

model Option {
  id          String @id @default(uuid())

  questionId  String
  question    Question @relation(fields: [questionId], references: [id])

  text        String

  isCorrect   Boolean @default(false)
  userAnswers UserAnswer[] // <-- required reverse relation

}


model TestAttempt {
  id          String @id @default(uuid())

  userId      String
  user        User @relation(fields: [userId], references: [id])

  mockTestId  String
  mockTest    MockTest @relation(fields: [mockTestId], references: [id])

  score       Int @default(0)

  totalMarks  Int @default(0)

  startedAt   DateTime @default(now())

  submittedAt DateTime?

  answers     UserAnswer[]

  createdAt   DateTime @default(now())
}

model TestSession {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  mockTestId String
  mockTest MockTest @relation(fields: [mockTestId], references: [id])

  status TestStatus @default(IN_PROGRESS)

  startedAt DateTime @default(now())

  lastSeenAt DateTime?

  submittedAt DateTime?

  expiresAt DateTime

  remainingSeconds Int

  score Int?

  answers UserAnswer[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([mockTestId])
  activities SessionActivity[]  

}



model UserAnswer {
  id String @id @default(uuid())

  attemptId String
  attempt TestAttempt @relation(fields: [attemptId], references: [id])

  sessionId String?
  session TestSession? @relation(fields: [sessionId], references: [id])

  questionId String
  question Question @relation(fields: [questionId], references: [id])

  selectedOptionId String
  selectedOption Option @relation(fields: [selectedOptionId], references: [id])

  isCorrect Boolean @default(false)
  isVisited Boolean @default(false)

  createdAt DateTime @default(now())
    @@unique([sessionId, questionId])

}

model SessionActivity {
  id String @id @default(uuid())

  sessionId String
  session TestSession @relation(fields: [sessionId], references: [id])

  eventType SessionEvent
  metadata Json?
  
  createdAt DateTime @default(now())
}


model UserTestEnrollment {
  id          String     @id @default(uuid())

  userId      String
  user        User       @relation(fields: [userId], references: [id])

  mockTestId  String
  mockTest    MockTest   @relation(fields: [mockTestId], references: [id])

  grantedAt   DateTime   @default(now())
  expiresAt   DateTime?  // null = lifetime access

  @@unique([userId, mockTestId])
}

model Transaction {
  id                String        @id @default(uuid())

  userId            String
  user              User          @relation(fields: [userId], references: [id])

  mockTestId        String?
  mockTest          MockTest?  @relation(fields: [mockTestId], references: [id])  // ← add ? here 

  amount            Float
  currency          String        @default("INR")
  passId            String?               // ← add this
  pass              Pass?      @relation(fields: [passId], references: [id])
  status            PaymentStatus @default(PENDING)

  // Razorpay fields (nullable until payment happens)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([mockTestId])
}


model StudyTopic {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])

  category    StudyGroupCategory
  title       String
  content     String              // HTML from Lexical editor
  votes       TopicVote[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([category])
}


model TopicVote {
  id         String          @id @default(uuid())

  userId     String
  user       User            @relation(fields: [userId], references: [id])

  topicId    String
  topic      StudyTopic      @relation(fields: [topicId], references: [id])

  importance TopicImportance

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, topicId])   // one vote per user per topic
  @@index([topicId])
}


model Pass {
  id          String   @id @default(uuid())
  name        String                        // e.g. "All Access Pass"
  description String?
  price       Float                         // e.g. 99.0
  currency    String   @default("INR")
  isActive    Boolean  @default(true)       // admin can disable a pass

  // null = lifetime, otherwise days from purchase
  validityDays Int?

  userPasses  UserPass[]
  transactions Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model UserPass {
  id        String     @id @default(uuid())

  userId    String
  user      User       @relation(fields: [userId], references: [id])

  passId    String
  pass      Pass       @relation(fields: [passId], references: [id])

  status    PassStatus @default(ACTIVE)

  grantedAt DateTime   @default(now())
  expiresAt DateTime?  // null = lifetime

  @@unique([userId, passId])
  @@index([userId])
}
