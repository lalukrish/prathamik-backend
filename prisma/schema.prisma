generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  createdById   String?
  createdBy     User?          @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  branches      Branch[]
  users         User[]
  jobs          Job[]
  candidates    Candidate[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  questionBanks QuestionBank[]
  interview     Interview[]
}

model Branch {
  id String @id @default(uuid())

  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
}

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String
  role     Role

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])

  createdOrganizations Organization[] @relation("OrganizationCreatedBy")

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  isActive Boolean @default(true)

  candidates  Candidate[]
  createdJobs Job[]        @relation("JobCreatedBy")
  updatedJobs Job[]        @relation("JobUpdatedBy")
  sessions    Session[]
  profile     UserProfile?
  interviewActivities InterviewActivity[] @relation("InterviewActivityUser")
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  phone        String?
  bio          String?
  addressLine1 String?
  city         String?
  state        String?
  country      String?
  zipCode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  device       String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean   @default(true)
  expiresAt    DateTime  @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  tokenHash    String?   @unique
  lastActiveAt DateTime? @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

model Job {
  id             String                 @id @default(uuid())
  title          String
  slug           String                 @unique
  description    String
  requiredSkills String[]
  niceToHave     String[]
  experienceMin  Int?
  experienceMax  Int?
  embedding      Unsupported("vector")?
  orgId          String
  createdBy      String
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  updatedBy      String?
  jdHtml         String?
  lastDate       DateTime?
  location       String?
  workMode       String?
  disabled       Boolean                @default(false)
  applications   Application[]
  creator        User                   @relation("JobCreatedBy", fields: [createdBy], references: [id])
  organization   Organization           @relation(fields: [orgId], references: [id])
  updater        User?                  @relation("JobUpdatedBy", fields: [updatedBy], references: [id])
  questionBanks  QuestionBank[]
}

model Candidate {
  id               String        @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  name             String
  email            String        @unique
  phone            String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  orgId            String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  currentRole      String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  linkedinUrl      String?
  skills           String[]
  totalExperience  Float?
  parsedData       Json?
  currentCTC       Float?
  expectedSalary   Float?
  isOnNoticePeriod Boolean       @default(false)
  noticePeriod     Int?
  createdBy        String?
  isBlocked        Boolean       @default(false)
  applications     Application[]
  resumes          Resume[]
  creator          User?         @relation(fields: [createdBy], references: [id])
  organization     Organization  @relation(fields: [orgId], references: [id])
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  interviewActivities InterviewActivity[]
  @@index([email])
  @@index([phone])
  @@index([orgId])
}

model Resume {
  id String @id @default(uuid())

  candidateId String

  resumeUrl String?

  storagePath String?

  fileName String

  fileSize Int

  mimeType String

  createdAt DateTime @default(now())

  // ============================================
  // Relations
  // ============================================

  candidate Candidate @relation(fields: [candidateId], references: [id])

  applications Application[]
}

model Application {
  id               String            @id @default(uuid())
  jobId            String
  candidateId      String
  resumeId         String?
  candidate        Candidate         @relation(fields: [candidateId], references: [id])
  job              Job               @relation(fields: [jobId], references: [id])
  resume           Resume?           @relation(fields: [resumeId], references: [id])
  status           ApplicationStatus @default(APPLIED)
  processingStatus ProcessingStatus  @default(QUEUED)
  processingError  String?
  parsedData       Json?
  overallScore     Int?
  aiSummary        String?
  matchedSkills    String[]
  missingSkills    String[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  scores           CandidateScore?
  interviews       Interview[]
  logs             ProcessingLog[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([processingStatus])
}

enum InterviewCancelledBy {
  RECRUITER
  CANDIDATE
  SYSTEM
}

model ProcessingLog {
  id            String      @id @default(uuid())
  applicationId String
  step          String
  status        String
  message       String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  application   Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model Interview {
  id                   String                @id @default(uuid())
  applicationId        String
  questionBankId       String?
  accessToken          String?               @unique
  title                String?
  status               InterviewStatus       @default(PENDING)
  // ==================================================
  // Scheduling
  // ==================================================
  scheduledStartAt     DateTime?
  scheduledEndAt       DateTime?
  expiresAt            DateTime?
  durationMinutes      Int?
  invitedAt            DateTime?
  // ==================================================
  // Interview Lifecycle
  // ==================================================
  startedAt            DateTime?
  startedByCandidateAt DateTime?
  completedAt          DateTime?
  submittedAt          DateTime?
  isSubmitted          Boolean               @default(false)
  submittedBySystem    Boolean               @default(false)
  // ==================================================
  // Cancellation
  // ==================================================
  cancelledAt          DateTime?
  cancelledByType      InterviewCancelledBy?
  cancelledById        String?
  cancelledReason      String?
  // ==================================================
  // Reschedule Support
  // ==================================================
  rescheduledFromId    String?
  rescheduledFrom      Interview?            @relation("InterviewReschedule", fields: [rescheduledFromId], references: [id])
  reschedules          Interview[]           @relation("InterviewReschedule")
  // ==================================================
  // Scoring
  // ==================================================
  totalQuestions       Int?
  totalScore           Int?
  cheatScore           Int?
  suspiciousEvents     Int                   @default(0)
  riskLevel            SecuritySeverity?
  // ==================================================
  // Email Tracking
  // ==================================================
  emailSent            Boolean               @default(false)
  emailSentAt          DateTime?
  emailError           String?
  // ==================================================
  // Audit
  // ==================================================
  createdById          String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  // ==================================================
  // Relations
  // ==================================================

  application    Application              @relation(fields: [applicationId], references: [id])
  questionBank   QuestionBank?            @relation(fields: [questionBankId], references: [id])
  questions      InterviewQuestion[]
  answers        InterviewAnswer[]
  securityEvents InterviewSecurityEvent[]
  activities     InterviewActivity[]
  Organization   Organization?            @relation(fields: [organizationId], references: [id])
  organizationId String?
  scores         CandidateScore[]
  // ==================================================
  // Indexes
  // ==================================================
  @@index([applicationId])
  @@index([status])
  @@index([scheduledStartAt])
  @@index([scheduledEndAt])
  @@index([expiresAt])
  @@index([questionBankId])
  @@index([rescheduledFromId])
}

model InterviewActivity {
  id          String    @id @default(uuid())
  interviewId String
  action      InterviewAction
  userId      String?
  candidateId String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId],references: [id],onDelete: Cascade)
  user        User?     @relation( "InterviewActivityUser",fields: [userId],references: [id])
  candidate   Candidate? @relation(fields: [candidateId],references: [id])
  @@index([interviewId])
  @@index([userId])
  @@index([candidateId])
  @@index([action])
  @@index([createdAt])
}

enum InterviewAction {
  INVITED
  SCHEDULED
  RESCHEDULED
  STARTED
  COMPLETED
  SUBMITTED
  CANCELLED
  EXPIRED
  AUTO_SUBMITTED
}

model InterviewQuestion {
  id String @id @default(uuid())

  interviewId String

  questionId String?

  question String

  type QuestionType

  difficulty DifficultyLevel?

  skillTags String[]

  options Json?

  correctAnswer Json?

  audioUrl String?

  aiGenerated Boolean @default(false)

  order Int

  maxScore Int @default(10)

  createdAt DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id])

  questionRef Question? @relation(fields: [questionId], references: [id])

  answers InterviewAnswer[]

  timeLimitSeconds Int?

  @@index([interviewId])
}

model InterviewAnswer {
  id              String            @id @default(uuid())
  interviewId     String
  questionId      String
  answerText      String?
  selectedOptions Json?
  audioAnswerUrl  String?
  transcription   String?
  score           Int?
  aiFeedback      String?
  cheatingFlag    Boolean           @default(false)
  answeredAt      DateTime          @default(now())
  interview       Interview         @relation(fields: [interviewId], references: [id])
  question        InterviewQuestion @relation(fields: [questionId], references: [id])
  durationSeconds Int?

  @@index([interviewId])
  @@index([questionId])
}

model QuestionBank {
  id             String            @id @default(uuid())
  orgId          String
  jobId          String?
  title          String
  description    String?
  mode           QuestionBankMode?
  aiGenerated    Boolean           @default(false)
  totalQuestions Int               @default(0)
  createdBy      String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  // =====================================================
  // Relations
  // =====================================================
  organization   Organization      @relation(fields: [orgId], references: [id])
  job            Job?              @relation(fields: [jobId], references: [id])
  questions      Question[]
  interviews     Interview[]

  @@index([orgId])
  @@index([jobId])
}

model Question {
  id String @id @default(uuid())

  questionBankId String

  question String

  type QuestionType

  difficulty DifficultyLevel

  weight Int @default(10)

  skillTags String[]

  timeLimitSeconds Int @default(60)

  options Json?

  audioUrl String?

  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id])

  interviewQuestions InterviewQuestion[]

  @@index([questionBankId])
}

enum QuestionBankMode {
  MANUAL
  AI
}

enum QuestionType {
  TEXT
  MULTIPLE_SELECT
  RADIO
  VOICE_SPEAK
  VOICE_TYPE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

model InterviewSecurityEvent {
  id          String            @id @default(uuid())
  interviewId String
  type        SecurityEventType
  severity    SecuritySeverity  @default(LOW)
  metadata    Json?
  createdAt   DateTime          @default(now())
  interview   Interview         @relation(fields: [interviewId], references: [id])

  @@index([interviewId])
  @@index([type])
}

enum SecurityEventType {
  TAB_SWITCH
  WINDOW_BLUR
  WINDOW_MINIMIZE
  FULLSCREEN_EXIT
  COPY_PASTE
  RIGHT_CLICK
  MULTIPLE_MONITORS
  DEVTOOLS_OPEN
  NETWORK_DISCONNECT
  LONG_INACTIVITY
  MULTIPLE_FACES
  VOICE_MISMATCH
  RAPID_ANSWERING
  SUSPICIOUS_TYPING
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CandidateScore {
  id             String      @id @default(uuid())
  applicationId  String      @unique
  interviewId    String     
  resumeScore    Int?
  interviewScore Int?
  technicalScore Int?
  communicationScore Int?
  problemSolvingScore Int?
  cheatScore     Int?
  overallScore   Int?
  aiFeedback     String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  application    Application @relation(fields: [applicationId], references: [id])
  interview      Interview   @relation(fields: [interviewId], references: [id])
}

enum Role {
  super_admin
  admin
  hr_manager
  recruiter
}

enum Source {
  applied
  manual
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
